# URL do deployment Convex (gerada por `npm run convex:dev` ou `npm run convex:deploy`)
VITE_CONVEX_URL=https://seu-projeto.convex.cloud

# Variáveis do lado do servidor (Convex Dashboard -> Settings -> Environment Variables).
# Opcional: chave Gemini usada pelos recursos de IA. Apenas Mestres autenticados
# podem acioná-la, com limite de uso por hora.
# GEMINI_API_KEY=
